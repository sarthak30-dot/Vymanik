# ─── Supabase (required for backend) ─────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # ← server-side only, never expose to browser

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Leave empty for same-origin Vercel deployment (/api/* is served by serverless fns).
# Set only if your backend is on a different domain.
VITE_API_BASE_URL=

# ─── Local dev ────────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=http://localhost:8080
